# Server & Environment
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://10.0.2.2:3000

# Aiven PostgreSQL Database (Placeholders only — never commit real credentials)
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require"
# Optional separate database/schema for automated E2E tests:
TEST_DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require&schema=e2e_test"

# Conservative Connection Pool & TLS Configuration (tuned for Aiven free-tier limits)
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_CONNECT_TIMEOUT_SECONDS=10
# Optional path to Aiven CA certificate file (outside repo or gitignored) to enforce sslmode=verify-full:
DATABASE_SSL_CA_PATH=""

# JWT & Session Security
JWT_ISSUER="https://auth.artha.app"
JWT_AUDIENCE="artha-mobile-client"
JWT_ACCESS_TTL_SECONDS=900
# Replace with a cryptographically random 64-byte hex string in production (min 32 chars required)
JWT_SIGNING_SECRET="replace-with-at-least-32-character-random-secret-key"

# Refresh Token & Session Lifecycle
REFRESH_TOKEN_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
REAUTH_WINDOW_SECONDS=300

# Email OTP & Password Policy
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_MINUTES=30

# Email Provider & Branding Configuration
# Supported modes: "smtp" | "local-outbox" (local-outbox is rejected in production)
EMAIL_PROVIDER="smtp"
EMAIL_FROM="Artha Security <aartha.app@gmail.com>"
APP_NAME="Artha"
APP_URL="https://artha.app"
SUPPORT_EMAIL="aartha.app@gmail.com"
EMAIL_LOGO_URL="https://raw.githubusercontent.com/13vanshmehta/Artha-App/main/src/assets/branding/artha_icon_blue.png"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
# Either set SMTP_USER / SMTP_PASS or ARTHA_EMAIL_ID / ARTHA_EMAIL_APP_PASSWORD:
ARTHA_EMAIL_ID=""
ARTHA_EMAIL_APP_PASSWORD=""

# Google OAuth Verification
# GOOGLE_WEB_CLIENT_ID is the primary expected ID-token audience verified by google-auth-library
GOOGLE_WEB_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com"

# Apple Sign-In Verification (comma-separated allowed bundle IDs / Services IDs)
APPLE_CLIENT_IDS="com.artha.app,com.frontend"
