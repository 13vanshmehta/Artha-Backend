generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  DISABLED
  DELETED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

/// The five ledger movements. See docs/API_CONTRACT.md §Transactions for the
/// per-type account/category rules (also enforced by a CHECK constraint).
enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUSTMENT
}

enum AccountType {
  CASH
  BANK
  WALLET
  CREDIT_CARD
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

/// How the money moved (rail), as opposed to Account (where the money lives).
enum PaymentMethod {
  CASH
  UPI
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  WALLET
  OTHER
}

/// Where a transaction came from. Phase 1 writes MANUAL only.
enum TransactionSource {
  MANUAL
  BANK_STATEMENT
  BANK_SYNC
  IMPORT
  SYSTEM
}

enum AdjustmentDirection {
  INCREASE
  DECREASE
}

/// What an emailed verification code is allowed to do. Sign-up codes and
/// email-change codes share one table, so every lookup filters on this (BE-08).
enum EmailChallengePurpose {
  SIGNUP_VERIFICATION
  EMAIL_CHANGE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  displayName     String
  email           String
  normalizedEmail String     @unique
  phoneNumber     String?
  /// IANA zone that defines "today", "this month", etc. for this user's data.
  timezone        String     @default("Asia/Kolkata")
  emailVerifiedAt DateTime?
  passwordHash    String?
  avatarUrl       String?
  isActive        Boolean    @default(true)
  status          UserStatus @default(UNVERIFIED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  identities                  AuthIdentity[]
  sessions                    AuthSession[]
  emailVerificationChallenges EmailVerificationChallenge[]
  passwordResetChallenges     PasswordResetChallenge[]
  securityEvents              SecurityEvent[]
  securityPreference          UserSecurityPreference?
  accounts                    Account[]
  categories                  Category[]
  transactions                Transaction[]
  groupMemberships            ExpenseGroupMember[]
  createdGroups               ExpenseGroup[]               @relation("GroupCreator")

  @@index([status])
  @@index([isActive])
  @@index([createdAt])
}

model UserSecurityPreference {
  id                              String    @id @default(uuid()) @db.Uuid
  userId                          String    @unique @db.Uuid
  biometricEnabled                Boolean   @default(false)
  biometricKeyId                  String?
  pinEnabled                      Boolean   @default(false)
  pinHash                         String?
  pinFailedAttempts               Int       @default(0)
  pinLockedUntil                  DateTime?
  appLockTimeoutSeconds           Int       @default(60)
  requireReauthForSensitiveAction Boolean   @default(true)
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id                      String       @id @default(uuid()) @db.Uuid
  userId                  String       @db.Uuid
  provider                AuthProvider
  providerSubject         String
  providerEmail           String?
  emailVerifiedByProvider Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  lastUsedAt              DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model AuthSession {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  deviceName            String
  platform              String    @default("unknown")
  refreshTokenHash      String?
  ipAddress             String?
  userAgent             String?
  lastReauthenticatedAt DateTime?
  createdAt             DateTime  @default(now())
  lastUsedAt            DateTime  @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?
  revokeReason          String?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  securityEvents SecurityEvent[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @db.Uuid
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
}

model EmailVerificationChallenge {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  purpose           EmailChallengePurpose @default(SIGNUP_VERIFICATION)
  email             String
  otpHash           String
  expiresAt         DateTime
  failedAttempts    Int                   @default(0)
  maxAttempts       Int                   @default(5)
  resendAvailableAt DateTime
  consumedAt        DateTime?
  createdAt         DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  /// Argon2id hash of the emailed 6-digit reset code (salted, so looked up by user, not by hash).
  tokenHash      String    @unique
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  maxAttempts    Int       @default(5)
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  sessionId String?  @db.Uuid
  eventType String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model ExpenseGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  currency    String   @default("INR")
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                 @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   ExpenseGroupMember[]

  @@index([createdById])
}

model ExpenseGroupMember {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now())

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Personal Expense Tracker ledger
//
// All money is BIGINT minor units (paise for INR). All new timestamps are
// timestamptz so `AT TIME ZONE <user tz>` bucketing is correct.
//
// The migration also creates constraints Prisma cannot express in this file.
// Keep them when editing these models, and re-add them if a generated
// migration tries to drop them:
//   - Account_userId_active_name_key    UNIQUE (userId, lower(name)) WHERE NOT isArchived
//   - Account_userId_default_key        UNIQUE (userId) WHERE isDefault
//   - Category_userId_type_active_name_key UNIQUE (userId, type, lower(name)) WHERE custom AND NOT isArchived
//   - CHECK constraints on amounts, currency codes and per-type field shape
// ---------------------------------------------------------------------------

model Account {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @db.Uuid
  name                String      @db.VarChar(60)
  type                AccountType
  currency            String      @default("INR") @db.Char(3)
  /// May be negative (e.g. a credit card that already carries a balance owed).
  openingBalanceMinor BigInt      @default(0)
  isDefault           Boolean     @default(false)
  isArchived          Boolean     @default(false)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransactions Transaction[] @relation("TransactionSourceAccount")
  incomingTransactions Transaction[] @relation("TransactionDestinationAccount")

  @@index([userId, isArchived])
}

model Category {
  id         String       @id @default(uuid()) @db.Uuid
  /// NULL for system categories, which every user can see but nobody can edit.
  userId     String?      @db.Uuid
  /// Stable identifier for system categories (e.g. "expense.food_dining").
  systemKey  String?      @unique @db.VarChar(64)
  name       String       @db.VarChar(40)
  type       CategoryType
  icon       String?      @db.VarChar(40)
  color      String?      @db.VarChar(9)
  isSystem   Boolean      @default(false)
  isArchived Boolean      @default(false)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, type])
}

model Transaction {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  type                 TransactionType
  amountMinor          BigInt
  /// Copied from the account(s) at write time; never supplied by the client.
  currency             String               @db.Char(3)
  categoryId           String?              @db.Uuid
  sourceAccountId      String?              @db.Uuid
  destinationAccountId String?              @db.Uuid
  /// ADJUSTMENT only. INCREASE credits destinationAccountId, DECREASE debits sourceAccountId.
  adjustmentDirection  AdjustmentDirection?
  paymentMethod        PaymentMethod?
  occurredAt           DateTime             @db.Timestamptz(3)
  payee                String?              @db.VarChar(120)
  note                 String?              @db.VarChar(500)
  /// REFUND only: the EXPENSE being refunded.
  relatedTransactionId String?              @db.Uuid
  source               TransactionSource    @default(MANUAL)
  clientTransactionId  String               @db.VarChar(64)
  /// SHA-256 of the normalised create request, used to tell a retry from key reuse.
  requestFingerprint   String               @db.Char(64)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?            @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction (checked at end of statement) rather than Restrict so that deleting
  // a User can cascade through accounts, categories and transactions in one go.
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  sourceAccount      Account?      @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: NoAction)
  destinationAccount Account?      @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: NoAction)
  relatedTransaction Transaction?  @relation("RefundOf", fields: [relatedTransactionId], references: [id], onDelete: NoAction)
  refunds            Transaction[] @relation("RefundOf")

  /// Idempotency: one financial record per client-generated id per user.
  @@unique([userId, clientTransactionId])
  /// History list (NEWEST/OLDEST keyset), recent, date-range summaries.
  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  /// Totals by type over a date range.
  @@index([userId, type, occurredAt])
  /// Category filter and per-category breakdown.
  @@index([userId, categoryId, occurredAt])
  /// Account filter and account balance aggregation.
  @@index([userId, sourceAccountId, occurredAt])
  @@index([userId, destinationAccountId, occurredAt])
  /// Refund-total lookups for an expense.
  @@index([relatedTransactionId])
}
